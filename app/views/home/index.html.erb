<div class="page-background">
  <div class="page-hero">
    <h1 class="page-title">Generate llms.txt</h1>
    <div data-controller="url-input" class="prompt-box">
    <%= form_tag llm_txts_path, method: :post, class: "prompt-box-inner prompt-box--url" do %>
      <input
        id="url"
        type="url"
        name="url"
        placeholder="https://example.com"
        autocomplete="url"
        class="prompt-input"
        data-url-input-target="input"
      >
      <div class="prompt-box-footer">
        <%= submit_tag "Generate", class: "prompt-submit-btn" %>
      </div>
    <% end %>
    </div>
  </div>
  <div id="root"></div>
</div>
